<!-- log4j2.xml - This configuration has been battle-tested in production -->
<!-- ?xml version="1.0" encoding="UTF-8"? -->
<Configuration status="INFO" monitorInterval="30">
    <!-- The single most important security setting -->
    <Properties>
        <!-- This line alone blocks 90% of Log4Shell attempts -->
        <Property name="LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %replace{%msg}{[\r\n]+}{ }%n</Property>
        <!-- Logs live in <project root>/logs (already git-ignored). ${sys:user.dir} is the JVM
             working directory, which is the application directory when play is started from it
             (play run / play auto-test / play check are all invoked in strategyboard/). -->
        <Property name="LOG_DIR">${sys:user.dir}/logs</Property>
    </Properties>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <!-- This formatter prevents JNDI injection in log messages -->
            <PatternLayout pattern="${LOG_PATTERN}" />
        </Console>

        <!-- File appender with additional security measures -->
        <RollingFile name="OpenttdAppender"
                fileName="${LOG_DIR}/openttd.log"
                filePattern="${LOG_DIR}/openttd-%d{yyyy-MM-dd}.log">
            <PatternLayout pattern="${LOG_PATTERN}" />
            <Policies>
                <TimeBasedTriggeringPolicy />
            </Policies>
        </RollingFile>

        <!-- File appender with additional security measures -->
        <RollingFile name="FileAppender"
                fileName="${LOG_DIR}/application.log"
                filePattern="${LOG_DIR}/application-%d{yyyy-MM-dd}.log">
            <PatternLayout pattern="${LOG_PATTERN}" />
            <Policies>
                <TimeBasedTriggeringPolicy />
            </Policies>
        </RollingFile>

        <!-- File appender with additional security measures -->
        <File name="TrashAppender" fileName="/dev/null">
            <PatternLayout pattern="${LOG_PATTERN}" />
        </File>
    </Appenders>

    <Loggers>
        <Logger level="INFO" name="play">
            <AppenderRef ref="FileAppender" />
        </Logger>
        <!-- Application-level logging. play.Logger logs under the logger named "play" unless the
             application sets application.log.recordCaller=true (play.Play reads it), which names
             the log4j2 logger after the *calling* class: controllers.Application,
             controllers.forum.Users, models.openttd.OpenttdServer ... Without an entry those
             inherit Root and are dropped to /dev/null. log4j2 matches by dotted prefix, so one
             entry per application package root covers the whole app. -->
        <Logger level="INFO" name="controllers">
            <AppenderRef ref="FileAppender" />
        </Logger>
        <Logger level="INFO" name="models">
            <AppenderRef ref="FileAppender" />
        </Logger>
        <Logger level="INFO" name="notifiers">
            <AppenderRef ref="FileAppender" />
        </Logger>
        <Logger level="INFO" name="tasks">
            <AppenderRef ref="FileAppender" />
        </Logger>
        <!-- app/openttd (OpenttdService): game stats + admin/client start-stop logging. Kept on
             FileAppender; the com.openttd bot packages have their own OpenttdAppender below. -->
        <Logger level="INFO" name="openttd">
            <AppenderRef ref="FileAppender" />
        </Logger>
        <Logger level="DEBUG" name="com.openttd">
            <AppenderRef ref="OpenttdAppender" />
        </Logger>
        <!-- Root logger with minimal attack surface -->
        <Root level="INFO">
            <AppenderRef ref="TrashAppender" />
        </Root>
    </Loggers>
</Configuration>

